{
  "name": "fundradar",
  "private": true,
  "scripts": {
    "dev": "pnpm -F web dev",
    "build": "pnpm -F @fundradar/shared build && pnpm -F web build",
    "lint": "pnpm -F @fundradar/shared lint && pnpm -F web lint",
    "typecheck": "pnpm -F @fundradar/shared build && pnpm -F web typecheck",
    "test": "pnpm -F @fundradar/shared test && pnpm -F web test",
    "seed": "pnpm -F scripts seed",
    "worker:ingest": "cd apps/worker && . .venv/bin/activate && python -m fundradar_worker.ingest_pem",
    "worker:monitor": "cd apps/worker && . .venv/bin/activate && python -m fundradar_worker.monitor",
    "worker:parse-urls": "cd apps/worker && . .venv/bin/activate && python -m fundradar_worker.parse_monitor_urls",
    "worker:aifi": "cd apps/worker && . .venv/bin/activate && python -m fundradar_worker.aifi_scraper",
    "merge-aifi": "pnpm -F scripts merge-aifi",
    "aifi:full": "pnpm worker:aifi && pnpm merge-aifi",
    "pipeline": "cd apps/worker && . .venv/bin/activate && python -m fundradar_worker.pipeline",
    "pipeline:signals": "cd apps/worker && . .venv/bin/activate && python -m fundradar_worker.pipeline --step filter && python -m fundradar_worker.pipeline --step enrich",
    "pipeline:signals-to-portfolio": "cd apps/worker && . .venv/bin/activate && python scripts/signal_to_portfolio.py",
    "worker:geocode": "cd apps/worker && . .venv/bin/activate && python -m fundradar_worker.geocode_funds",
    "worker:linkedin": "cd apps/worker && . .venv/bin/activate && python -m fundradar_worker.linkedin.batch_scraper",
    "gemini:validate": "python3 scripts/validate-gemini-audit-state.py",
    "gemini:rebuild": "python3 scripts/rebuild-gemini-audit-from-canonical.py",
    "gemini:apply:dry": "python3 scripts/apply-gemini-missing-assets.py",
    "gemini:apply": "python3 scripts/apply-gemini-missing-assets.py --apply",
    "signals:backfill-top-aum": "python3 scripts/backfill_top_aum_signals.py --apply",
    "verify:new-fund-completion": "python3 scripts/verify_new_fund_completion.py",
    "verify:new-fund-gate": "python3 scripts/check_new_fund_gate.py",
    "pipeline:new-fund-quality": "python3 scripts/run_new_fund_quality_pipeline.py",
    "slug:validate": "python3 scripts/validate-slug-consistency.py",
    "slug:cleanup:dry": "python3 scripts/cleanup-derived-slug-artifacts.py",
    "slug:cleanup:derived": "python3 scripts/cleanup-derived-slug-artifacts.py --apply",
    "audit:quality": "pnpm -F scripts audit-quality",
    "digest:build": "pnpm -F scripts digest:build",
    "digest:send": "pnpm -F scripts digest:send",
    "digest:suppress": "pnpm -F scripts digest:suppress"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@vercel/speed-insights": "^1.3.1"
  }
}
