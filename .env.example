# Fundradar Environment Variables
# Copy this file to .env and fill in your values

# Apify API Token for LinkedIn scraping
# Get yours at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Gemini API Key for portfolio enrichment (sector/HQ/description)
# Get yours at: https://aistudio.google.com/apikey
# Optional — pipeline skips enrichment step if not set
GEMINI_API_KEY=

# Stripe — subscription payments (EUR 9/month)
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUBSCRIPTION_PRICE_EUR=9

# Optional legal-page public details
NEXT_PUBLIC_LEGAL_CONTROLLER_NAME=Fundradar
NEXT_PUBLIC_LEGAL_CONTROLLER_EMAIL=
NEXT_PUBLIC_LEGAL_CONTROLLER_ADDRESS=
NEXT_PUBLIC_LEGAL_JURISDICTION=Italy
NEXT_PUBLIC_LEGAL_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_VAT_ID=
NEXT_PUBLIC_LEGAL_REA_NUMBER=
NEXT_PUBLIC_LEGAL_PEC_EMAIL=
NEXT_PUBLIC_LEGAL_REGISTERED_CAPITAL=
NEXT_PUBLIC_LEGAL_DIGEST_UNSUBSCRIBE_EMAIL=
NEXT_PUBLIC_LEGAL_BILLING_PORTAL_URL=
NEXT_PUBLIC_LEGAL_BUNDLE_VERSION=2026-02-19

# Optional digest tooling controls (scripts/build-weekly-digest.ts)
DIGEST_UNSUBSCRIBE_EMAIL=
DIGEST_BILLING_PORTAL_URL=
