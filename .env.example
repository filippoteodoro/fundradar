# Fundradar web app: all variables are optional. Copy to apps/web/.env.local for local development.
# Pipeline API keys: see apps/worker/.env.example.

# Public site URL for canonical links and the sitemap (default: https://fundradar.vercel.app).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Tag Manager container. Unset means no analytics.
NEXT_PUBLIC_GTM_ID=

# Legal-page details.
NEXT_PUBLIC_LEGAL_CONTROLLER_NAME=
NEXT_PUBLIC_LEGAL_CONTROLLER_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=
