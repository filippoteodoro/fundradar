# FundRadar Worker Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# PLAYWRIGHT SETTINGS
# =============================================================================

# Path to store Playwright browsers (default: system default)
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Run browsers in headless mode (default: true)
PLAYWRIGHT_HEADLESS=true

# =============================================================================
# SCRAPING SETTINGS
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
FUNDRADAR_LOG_LEVEL=INFO

# Data directory for storing derived data (default: ./data)
FUNDRADAR_DATA_DIR=/app/data

# Maximum concurrent browser contexts (default: 3)
FUNDRADAR_MAX_CONCURRENT=3

# Default rate limit in seconds between requests to same domain (default: 2.0)
FUNDRADAR_RATE_LIMIT_DEFAULT=2.0

# Global rate limit - max requests per minute across all domains (default: 30)
FUNDRADAR_GLOBAL_RATE_LIMIT=30

# Request timeout in seconds (default: 30)
FUNDRADAR_REQUEST_TIMEOUT=30

# Maximum retries for failed requests (default: 3)
FUNDRADAR_MAX_RETRIES=3

# =============================================================================
# CIRCUIT BREAKER SETTINGS
# =============================================================================

# Number of consecutive failures before opening circuit (default: 5)
FUNDRADAR_CIRCUIT_FAILURE_THRESHOLD=5

# Cooldown period in seconds before trying again (default: 300)
FUNDRADAR_CIRCUIT_COOLDOWN=300

# =============================================================================
# ALERTING SETTINGS
# =============================================================================

# Webhook URL for alerts (e.g., Slack, Discord, email service)
# Leave empty to disable webhooks
FUNDRADAR_ALERT_WEBHOOK=

# Telegram Bot settings for alerts
# Get your bot token from @BotFather on Telegram
FUNDRADAR_TELEGRAM_BOT_TOKEN=
# Chat ID to send alerts to (use get_telegram_chat_id.py to discover)
FUNDRADAR_TELEGRAM_CHAT_ID=

# Error rate threshold to trigger alerts (default: 0.2 = 20%)
FUNDRADAR_ERROR_THRESHOLD=0.2

# Confidence drop threshold to trigger alerts (default: 0.2 = 20%)
FUNDRADAR_CONFIDENCE_THRESHOLD=0.2

# Consecutive failures before alerting (default: 3)
FUNDRADAR_FAILURE_THRESHOLD=3

# Send daily summary emails (default: true)
FUNDRADAR_DAILY_SUMMARY=true

# Send immediate alerts for critical failures (default: true)
FUNDRADAR_IMMEDIATE_ALERTS=true

# =============================================================================
# GRACEFUL SHUTDOWN
# =============================================================================

# Maximum time to wait for graceful shutdown in seconds (default: 30)
FUNDRADAR_SHUTDOWN_TIMEOUT=30

# =============================================================================
# DATABASE (for future Supabase integration)
# =============================================================================

# Supabase URL (leave empty for file-based storage)
SUPABASE_URL=

# Supabase service role key
SUPABASE_SERVICE_KEY=
