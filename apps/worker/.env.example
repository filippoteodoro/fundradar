# Fundradar worker: copy to apps/worker/.env and fill in the keys you need.
# The root .env is also read; values in this file override it.
# Tuning variables (rate limits, timeouts, circuit breaker): see docs/runbook.md.

# Signal enrichment (pipeline step 8). Required for `pnpm pipeline`.
OPENAI_API_KEY=

# Italian-to-English translation. DeepL is primary, Azure is the fallback.
DEEPL_API_KEY=
DEEPL_API_KEY_2=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Optional: portfolio enrichment and the Gemini audit scripts.
GEMINI_API_KEY=

# Optional: LinkedIn scraping (docs/linkedin-scraping.md).
APIFY_API_TOKEN=

# Optional: pipeline alerts to a Telegram chat.
FUNDRADAR_TELEGRAM_BOT_TOKEN=
FUNDRADAR_TELEGRAM_CHAT_ID=

# Optional: run Playwright with a visible browser for debugging.
PLAYWRIGHT_HEADLESS=true
